{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/convert",
      "destination": "/document-converter",
      "permanent": true
    },
    {
      "source": "/pdf-merge",
      "destination": "/merge-pdf",
      "permanent": true
    },
    {
      "source": "/pdf-split",
      "destination": "/split-pdf",
      "permanent": true
    },
    {
      "source": "/pdf-organize",
      "destination": "/organize-pdf",
      "permanent": true
    },
    {
      "source": "/pdf-compress",
      "destination": "/compress-pdf",
      "permanent": true
    },
    {
      "source": "/pdf-protect",
      "destination": "/protect-pdf",
      "permanent": true
    },
    {
      "source": "/pdf-unlock",
      "destination": "/unlock-pdf",
      "permanent": true
    },
    {
      "source": "/pdf-stamp",
      "destination": "/watermark-pdf",
      "permanent": true
    },
    {
      "source": "/pdf-ocr",
      "destination": "/ocr",
      "permanent": true
    },
    {
      "source": "/pdf-to-img",
      "destination": "/pdf-to-jpg",
      "permanent": true
    },
    {
      "source": "/img-to-pdf",
      "destination": "/jpg-to-pdf",
      "permanent": true
    },
    {
      "source": "/img-convert",
      "destination": "/image-converter",
      "permanent": true
    },
    {
      "source": "/img-resize",
      "destination": "/image-compressor",
      "permanent": true
    },
    {
      "source": "/json",
      "destination": "/json-formatter",
      "permanent": true
    },
    {
      "source": "/json-query",
      "destination": "/jsonpath-tester",
      "permanent": true
    },
    {
      "source": "/data-convert",
      "destination": "/data-converter",
      "permanent": true
    },
    {
      "source": "/table-clean",
      "destination": "/csv-cleaner",
      "permanent": true
    },
    {
      "source": "/hash",
      "destination": "/checksum-calculator",
      "permanent": true
    },
    {
      "source": "/word-merge",
      "destination": "/merge-word",
      "permanent": true
    },
    {
      "source": "/excel-combine",
      "destination": "/combine-excel",
      "permanent": true
    },
    {
      "source": "/find-replace",
      "destination": "/find-and-replace",
      "permanent": true
    },
    {
      "source": "/doc-stats",
      "destination": "/word-counter",
      "permanent": true
    },
    {
      "source": "/metadata",
      "destination": "/remove-metadata",
      "permanent": true
    },
    {
      "source": "/diff",
      "destination": "/file-comparison",
      "permanent": true
    },
    {
      "source": "/zip-create",
      "destination": "/create-zip",
      "permanent": true
    },
    {
      "source": "/zip-open",
      "destination": "/zip-extractor",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
